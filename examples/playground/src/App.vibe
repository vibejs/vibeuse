<script setup lang="ts">
import { computed, ref } from '@usevibejs/ui';
import { useClipboard, useDark, useEventListener } from '@usevibejs/use';
import { marked } from 'marked';
import { categories, functions } from '../../../docs/catalog.ts';
import Demo from './Demo.vibe';
const rawPages = import.meta.glob<string>('../../../docs/**/*.md', { query: '?raw', import: 'default', eager: true });
const page = ref(location.hash.slice(2) || 'getting-started/introduction');
useEventListener(window, 'hashchange', () => { page.value = location.hash.slice(2) || 'getting-started/introduction'; search.value = ''; mobileOpen.value = false; document.getElementById('main')?.focus(); });
const search = ref(''); const category = ref('All'); const mobileOpen = ref(false);
const theme = useDark({ target: document.documentElement, storageKey: 'vibeuse-site-theme' });
const themeIsDark = theme.isDark;
const clipboard = useClipboard();
const copied = clipboard.copied;
const copyExample = () => {
  const fn = selected.value;
  if (fn) void clipboard.copy(`import { ref, shallowRef, computed } from '@usevibejs/ui';\nimport { ${fn.name} } from '@usevibejs/use';\n\n${fn.code}`);
};
const selected = computed(() => functions.find(fn => page.value === `functions/${fn.name}`));
const matching = computed(() => functions.filter(fn => (category.value === 'All' || fn.category === category.value) && `${fn.name} ${fn.description}`.toLowerCase().includes(search.value.toLowerCase())));
const html = computed(() => {
  const raw = rawPages[`../../../docs/${page.value}.md`];
  return marked.parse(raw ?? '# Page not found\n\nChoose a guide or function from the navigation.', { async: false });
});
const guides = [
  { title: 'Getting started', pages: ['introduction', 'installation', 'quick-start', 'why-vibeuse', 'framework-compatibility'] },
  { title: 'Guide', pages: ['reactivity', 'refs-and-getters', 'lifecycle', 'browser-apis', 'storage', 'event-handling', 'performance', 'typescript', 'troubleshooting'] },
  { title: 'Advanced', pages: ['custom-composables', 'building-reusable-utilities', 'integrating-with-vibecn', 'testing', 'contribution-guide', 'architecture'] },
];
const visibleGuides = computed(() => search.value ? [] : guides);
const title = (slug: string) => slug.split('-').map(word => word[0].toUpperCase() + word.slice(1)).join(' ');
const groupPath = (group: string) => group === 'Getting started' ? 'getting-started' : group.toLowerCase();
</script>
<template>
  <div class="site-shell">
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#/getting-started/introduction" aria-label="VibeUse home"><span class="brand-symbol">v<span>u</span></span><strong>VibeUse</strong><span class="version">0.1</span></a>
      <nav aria-label="Primary"><a href="#/getting-started/introduction">Documentation</a><a href="#/functions/useCounter">Playground</a><a href="https://github.com/vibejs/vibeuse">GitHub ↗</a></nav>
      <button type="button" class="theme-button" @click="theme.toggle" :aria-label="themeIsDark ? 'Use light theme' : 'Use dark theme'">{{ themeIsDark ? '☀' : '☾' }}</button>
      <button type="button" class="menu-button" @click="mobileOpen = !mobileOpen" :aria-expanded="mobileOpen" aria-controls="docs-sidebar">Menu</button>
    </header>
    <aside id="docs-sidebar" :class="['sidebar', { open: mobileOpen }]">
      <label class="search"><span>⌕</span><input v-model="search" type="search" placeholder="Find a composable…" aria-label="Find a composable" /></label>
      <nav aria-label="Documentation">
        <div v-for="group in visibleGuides" :key="group.title" class="nav-group"><h2>{{ group.title }}</h2><a v-for="slug in group.pages" :key="slug" :href="'#/' + groupPath(group.title) + '/' + slug" :aria-current="page === groupPath(group.title) + '/' + slug ? 'page' : undefined">{{ title(slug) }}</a></div>
        <div class="nav-group"><h2>Functions <span>42</span></h2><label class="sr-only" for="category">Filter category</label><select id="category" v-model="category"><option>All</option><option v-for="item in categories" :key="item">{{ item }}</option></select>
          <a v-for="fn in matching" :key="fn.name" :href="'#/functions/' + fn.name" :aria-current="selected?.name === fn.name ? 'page' : undefined" class="function-link">{{ fn.name }}<span>{{ fn.category }}</span></a>
          <p v-if="!matching.length" class="muted">No composables match.</p>
        </div>
      </nav>
      <div class="sidebar-footer">Built for Vibe.js <span>Native to the core.</span></div>
    </aside>
    <main id="main" tabindex="-1" class="content">
      <div v-if="page === 'getting-started/introduction'" class="intro-hero">
        <div class="eyebrow"><span class="status-dot" /> The native Vibe.js toolkit</div>
        <h1>Useful by nature.<br /><span>Reactive by Vibe.</span></h1>
        <p class="lede">Essential Composables for Vibe.js. Small, typed building blocks for the browser, your state, and everything in between.</p>
        <div class="install-command"><code>pnpm add @usevibejs/use</code><button type="button" @click="clipboard.copy('pnpm add @usevibejs/use')" :aria-label="copied ? 'Command copied' : 'Copy install command'">{{ copied ? 'Copied' : 'Copy' }}</button></div>
        <div class="hero-links"><a class="primary-link" href="#/getting-started/quick-start">Start building →</a><a href="#/functions/useDebounce">Explore the composables ↗</a></div>
        <div class="principles"><div><strong>42 focused functions</strong><span>One package. Six categories.</span></div><div><strong>Vibe.js all the way down</strong><span>One reactive runtime.</span></div><div><strong>A clear end to every effect</strong><span>Automatic scope cleanup.</span></div></div>
        <div class="section-heading"><div><span class="eyebrow">Try it now</span><h2>A little state. A useful history.</h2></div><a href="#/functions/useRefHistory">View API →</a></div>
        <Demo name="useRefHistory" />
      </div>
      <div v-if="selected" class="function-heading"><div class="eyebrow">{{ selected.category }} / {{ selected.name }}</div><h1>{{ selected.name }}</h1><p class="lede">{{ selected.description }}</p><Demo :key="selected.name" :name="selected.name" /><div class="section-heading"><h2>Implementation guide</h2><button type="button" @click="copyExample">{{ copied ? 'Copied' : 'Copy example' }}</button></div></div>
      <article v-if="page !== 'getting-started/introduction'" class="prose" v-html="html" />
      <section v-if="page === 'getting-started/introduction'" class="function-directory"><div class="section-heading"><div><span class="eyebrow">The collection</span><h2>Find your next building block.</h2></div></div><div class="category-grid"><a v-for="item in categories" :key="item" :href="'#/functions/' + functions.find(fn => fn.category === item)?.name"><h3>{{ item }} <span>↗</span></h3><p>{{ functions.filter(fn => fn.category === item).length }} composables</p><code>{{ functions.find(fn => fn.category === item)?.name }}</code></a></div></section>
      <footer class="content-footer"><span>VibeUse · MIT License</span><a href="#/advanced/contribution-guide">Made to be built on ↗</a></footer>
    </main>
  </div>
</template>
