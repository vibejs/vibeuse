{
  "name": "@usevibejs/use",
  "version": "0.1.1",
  "description": "Essential composables for vibe.js.",
  "keywords": [
    "composables",
    "reactivity",
    "typescript",
    "utilities",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibeuse#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibeuse/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibeuse.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity.d.ts",
      "import": "./dist/reactivity.js",
      "default": "./dist/reactivity.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./sensors": {
      "types": "./dist/sensors.d.ts",
      "import": "./dist/sensors.js",
      "default": "./dist/sensors.js"
    },
    "./timers": {
      "types": "./dist/timers.d.ts",
      "import": "./dist/timers.js",
      "default": "./dist/timers.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite examples/playground --host 127.0.0.1",
    "build": "tsdown && vite build examples/playground && node scripts/site-notices.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit && pnpm --dir examples/playground exec tsc -b --runExternalCode && node scripts/check-docs.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt src test scripts benchmarks examples docs/catalog.ts *.ts *.json .changeset .github",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/browser.ts",
    "test:package": "node scripts/package.ts",
    "bench": "node benchmarks/run.ts",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:browser && pnpm test:package",
    "docs:generate": "tsdown && node scripts/generate-docs.ts",
    "test:integration": "pnpm test:browser && pnpm test:package",
    "precheck": "pnpm build:library",
    "build:library": "tsdown",
    "fmt:check": "oxfmt --check src test scripts benchmarks examples docs/catalog.ts *.ts *.json .changeset .github",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/language-tools": "0.1.0",
    "@usevibejs/ui": "0.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "marked": "18.1.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@usevibejs/ui": "^0.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@11.18.0"
}
