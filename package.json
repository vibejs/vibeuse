{
  "name": "@usevibejs/use",
  "version": "0.1.0",
  "description": "Essential Composables for Vibe.js",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibeuse.git"
  },
  "homepage": "https://github.com/vibejs/vibeuse#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibeuse/issues"
  },
  "keywords": [
    "vibejs",
    "composables",
    "reactivity",
    "utilities",
    "typescript"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity.d.ts",
      "import": "./dist/reactivity.js",
      "default": "./dist/reactivity.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./sensors": {
      "types": "./dist/sensors.d.ts",
      "import": "./dist/sensors.js",
      "default": "./dist/sensors.js"
    },
    "./timers": {
      "types": "./dist/timers.d.ts",
      "import": "./dist/timers.js",
      "default": "./dist/timers.js"
    }
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@11.18.0",
  "peerDependencies": {
    "@usevibejs/ui": "^0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@usevibejs/ui": "0.1.0",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/language-tools": "0.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "tsdown": "0.23.1",
    "typescript": "7.1.0-dev.20261015.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "vite examples/playground --host 127.0.0.1",
    "build": "tsdown && vite build examples/playground",
    "typecheck": "tsc --noEmit && tsc -b examples/playground --runExternalCode && node scripts/check-docs.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/browser.ts",
    "test:package": "node scripts/package.ts",
    "bench": "node benchmarks/run.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:browser && pnpm test:package"
  }
}
